# dependencies
node_modules/

# next.js
.next/
out/

# production
build/

# env files
.env*
!.env.example

# vercel
.vercel

# netlify — local link state (state.json holds the site id), build cache and
# bundled functions. Regenerated by the CLI on demand; never belongs in the repo.
.netlify/

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify — commit the graph itself, ignore the local AST cache and run state
graphify-out/*
!graphify-out/GRAPH_REPORT.md
!graphify-out/graph.html
!graphify-out/graph.json
